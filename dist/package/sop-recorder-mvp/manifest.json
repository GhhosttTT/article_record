{
  "manifest_version": 3,
  "name": "SOP Recorder MVP",
  "version": "0.1.0",
  "description": "Record web operations as structured SOP nodes with screenshots and tab-switch context.",
  "permissions": ["activeTab", "downloads", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SOP Recorder"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["viewer.html", "shared/artifacts.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "minimum_chrome_version": "102"
}
