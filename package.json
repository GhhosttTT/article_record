{
  "name": "sop-recorder-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension MVP for recording SOP steps with screenshots and tab-switch context.",
  "scripts": {
    "generate": "node tools/generate_artifacts.js",
    "generate:pdf": "node tools/generate_pdf.js",
    "package:extension": "node tools/package_extension.js",
    "render-video": "node tools/render_video.js",
    "render-video:4k": "node tools/render_video.js --resolution=4k",
    "render-video:1080p": "node tools/render_video.js --resolution=1080p",
    "render-video:frames": "node tools/render_video.js --frames-only",
    "verify": "node tools/verify.js"
  }
}
